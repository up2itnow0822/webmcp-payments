{
  "name": "webmcp-payments",
  "version": "0.4.2",
  "description": "x402 (HTTP 402) payment gate, on-chain verifier and WebMCP pricing discovery for EVM chains (Base, Arbitrum, Optimism). No platform fee by default.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware/index.mjs",
      "require": "./dist/middleware/index.js",
      "types": "./dist/middleware/index.d.ts"
    },
    "./verifier": {
      "import": "./dist/verifier/index.mjs",
      "require": "./dist/verifier/index.js",
      "types": "./dist/verifier/index.d.ts"
    },
    "./discovery": {
      "import": "./dist/discovery/index.mjs",
      "require": "./dist/discovery/index.js",
      "types": "./dist/discovery/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "webmcp",
    "x402",
    "agent-payments",
    "http-402",
    "usdc",
    "base",
    "evm",
    "mcp",
    "ai-agent",
    "payment-gateway"
  ],
  "author": "up2itnow5280",
  "license": "MIT",
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "dependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
